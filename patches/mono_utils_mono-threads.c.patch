@@ -976,6 +992,7 @@
 #endif
 	g_assert (res);
 
+	g_printerr ("MONO98: keys info=%lu exited=%lu small=%d | ", (unsigned long) thread_info_key, (unsigned long) thread_exited_key, (int) small_id_key);
 	if ((sleepLimit = g_getenv ("MONO_SLEEP_ABORT_LIMIT")) != NULL) {
 		mono_set_errno (0);
 		long threshold = strtol(sleepLimit, NULL, 10);
@@ -2083,6 +2100,8 @@
 gboolean
 mono_thread_info_is_current (MonoThreadInfo *info)
 {
+	if ((gpointer) info == (gpointer) -1)
+		g_printerr ("MONO98: is_current(-1) caller=%p | ", __builtin_return_address (0));
 	return mono_thread_info_get_tid (info) == mono_native_thread_id_get ();
 }
 
