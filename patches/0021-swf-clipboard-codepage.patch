 		internal static String AnsiToString(IntPtr ansi_data) {
-			return (string)Marshal.PtrToStringAnsi(ansi_data);
+			if (ansi_data == IntPtr.Zero)
+				return null;
+			// Win9x/ME: clipboard CF_TEXT is in the system ANSI code page
+			// (e.g. 936 for Chinese).  Marshal.PtrToStringAnsi assumes UTF-8
+			// here and throws ExecutionEngineException ("Illegal byte
+			// sequence") on non-ASCII text, so decode via GetACP.
+			int len = 0;
+			while (Marshal.ReadByte (ansi_data, len) != 0)
+				len++;
+			if (len == 0)
+				return String.Empty;
+			byte [] bytes = new byte [len];
+			Marshal.Copy (ansi_data, bytes, 0, len);
+			try {
+				return Encoding.GetEncoding ((int) Win32GetACP ()).GetString (bytes);
+			} catch {
+				return (string)Marshal.PtrToStringAnsi(ansi_data);
+			}
 		}
 
